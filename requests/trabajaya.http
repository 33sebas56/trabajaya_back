### TrabajaYA API - IntelliJ HTTP Client / VS Code REST Client
# Copiar este archivo a requests/private.local.http antes de introducir datos reales.
# Esa copia esta ignorada por Git. Los tokens son privados; no proyectarlos completos.
@base = https://TU_BACKEND.onrender.com/api
@clientEmail = cliente@example.invalid
@workerEmail = trabajador@example.invalid
@password = REEMPLAZAR_EN_COPIA_PRIVADA
@categoryId = 1
@clientToken = PEGA_TOKEN_CLIENTE
@workerToken = PEGA_TOKEN_TRABAJADOR
@jobId = 1
@assignmentId = 1

### Salud publica
GET {{base}}/health

### Categorias reales: copiar el ID deseado a categoryId
GET {{base}}/categories

### Registrar cliente (no crea administrador)
POST {{base}}/auth/register
Content-Type: application/json

{"name":"Cliente de exhibicion","email":"{{clientEmail}}","password":"{{password}}","role":"CLIENTE","phone":"3000000000","city":"Pasto","skills":[],"experience":0,"radiusKm":20,"acceptedTerms":true}

### Registrar trabajador; copiar su token de respuesta
POST {{base}}/auth/register
Content-Type: application/json

{"name":"Trabajador de exhibicion","email":"{{workerEmail}}","password":"{{password}}","role":"TRABAJADOR","phone":"3000000001","city":"Pasto","skills":[{{categoryId}}],"experience":2,"radiusKm":20,"acceptedTerms":true}

### Login cliente creado por registro
POST {{base}}/auth/login
Content-Type: application/json

{"email":"{{clientEmail}}","password":"{{password}}"}

### Login trabajador creado por registro
POST {{base}}/auth/login
Content-Type: application/json

{"email":"{{workerEmail}}","password":"{{password}}"}

### Mi perfil
GET {{base}}/me
Authorization: Bearer {{clientToken}}

### Publicar - ajusta fecha e ids de categoria
POST {{base}}/jobs
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{"title":"Instalar una lampara","description":"Instalar una lampara con materiales disponibles y herramienta propia del trabajador.","categoryId":{{categoryId}},"city":"Pasto","zone":"Centro","address":"Direccion privada de demostracion","latitude":null,"longitude":null,"scheduledAt":"2030-05-20T09:00:00-05:00","durationHours":2,"workersNeeded":1,"initialPrice":60000,"maxPrice":100000,"incrementAmount":10000,"intervalMinutes":10,"autoIncrease":false,"mediaIds":[]}

### Mis publicaciones
GET {{base}}/jobs?mine=true
Authorization: Bearer {{clientToken}}

### Aumentar oferta
POST {{base}}/jobs/{{jobId}}/increase
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{"amount":10000}

### Detalle como trabajador: sin direccion antes de aceptar
GET {{base}}/jobs/{{jobId}}
Authorization: Bearer {{workerToken}}

### Aceptar precio actual (cambia expectedPrice si corresponde)
POST {{base}}/jobs/{{jobId}}/accept
Authorization: Bearer {{workerToken}}
Content-Type: application/json

{"expectedPrice":70000}

### Enviar mensaje
POST {{base}}/assignments/{{assignmentId}}/messages
Authorization: Bearer {{workerToken}}
Content-Type: application/json

{"body":"Hola, llevare las herramientas.","mediaId":null}

### Avanzar uno por uno: EN_CAMINO, EN_LUGAR, INICIADO, TERMINADO
POST {{base}}/assignments/{{assignmentId}}/status
Authorization: Bearer {{workerToken}}
Content-Type: application/json

{"status":"EN_CAMINO"}

### Confirmar como cliente, solo despues de TERMINADO
POST {{base}}/assignments/{{assignmentId}}/status
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{"status":"CONFIRMADO"}

### Calificar
POST {{base}}/assignments/{{assignmentId}}/review
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{"score":5,"comment":"Buen trabajo y comunicacion."}
