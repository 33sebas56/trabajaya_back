# Optional development configuration. Copy to local.properties only if needed.
# This file is not required for Render and must never contain committed secrets.
# Select profiles using SPRING_PROFILES_ACTIVE, not inside this file.
app.seed.enabled=false
app.reset.console=false
app.storage.provider=local
# To opt into demo data exclusively on a private local database:
# app.seed.enabled=true
# To inspect a reset link exclusively in private development logs:
# app.reset.console=true
